generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model User {
  id           String          @id @default(cuid())
  name         String
  email        String          @unique
  passwordHash String
  createdAt    DateTime        @default(now())
  days         InternshipDay[]
}

model InternshipDay {
  id          String   @id @default(cuid())
  userId      String
  /// YYYY-MM-DD: date-only string prevents timezone shifts.
  date        String
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  tasks       Task[]

  @@index([userId, date])
}

model Task {
  id          String        @id @default(cuid())
  dayId       String
  title       String
  description String?
  status      TaskStatus    @default(TODO)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  day         InternshipDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([dayId])
}
